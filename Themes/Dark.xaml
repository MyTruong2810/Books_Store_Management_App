<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Key="Dark">
    <!-- MainPage -->
    <Color x:Key="NavigationViewColor">#2C3E50</Color>
    <!-- Darker shade -->
    <Color x:Key="NavigationViewItemBackgroundColor">#1C2A34</Color>
    <!-- Darker background -->

    <!-- AdminPage -->
    <Color x:Key="StackPanelBackgroundColor">#1E1E1E</Color>
    <!-- Dark background -->
    <Color x:Key="HeaderBackgroundColor">#34495E</Color>
    <!-- Darker header -->
    <Color x:Key="AdminPanelBackgroundColor">#455054</Color>
    <!-- Darker admin panel -->
    <Color x:Key="AdminPanelBorderColor">DarkSlateBlue</Color>
    <!-- Darker border color -->
    <Color x:Key="AdminTextColor">#E1E1E1</Color>
    <!-- Lighter text for contrast -->
    <Color x:Key="AdminButtonBackgroundColor">#2E8B57</Color>
    <!-- Darker green -->
    <Color x:Key="AdminButtonForegroundColor">White</Color>
    <!-- White text on buttons -->
    <Color x:Key="AdminButtonBorderColor">White</Color>
    <!-- White border -->
    <Color x:Key="AdminDialogBackgroundColor">#333333</Color>
    <!-- Dark dialog background -->
    <Color x:Key="AdminDialogTextColor">#E1E1E1</Color>
    <!-- Lighter text in dialog -->
</ResourceDictionary>
